extend type Query {
    me: User
    users(page: Int = 1, size: Int = 20): UserPage!
}

type UserPage {
    items: [User!]!
    pageInfo: PageInfo!
}

extend type Mutation {
    signUp(name: String!, email: String!, password: String!): User!

    login(email: String!, password: String!): User!

    logout: Boolean!
}

type User {
    id: ID!
    name: String!
    email: String!
    latestLoginIp: String
    lastLoginDate: String
    createdAt: String
    modifiedAt: String
}
