extend type Query {
    personTranslations(personId: ID!): [PersonTranslation!]!
    personTranslation(id: ID!): PersonTranslation
}

extend type Mutation {
    addPersonTranslation(personId: ID!, language: String!, name: String!): PersonTranslation!
    modifyPersonTranslation(id: ID!, language: String!, name: String!): PersonTranslation!
    deletePersonTranslation(id: ID!): Boolean!
}
